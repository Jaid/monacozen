+const getRecursiveAliasDiagnostics = (document: TextDocument): Diagnostic[] => {
+  const text = document.getText()
+  if (!(text.includes('&') && text.includes('*'))) {
+    return []
+  }
+  const diagnostics: Diagnostic[] = []
+  try {
+    for (const yamlDocument of parseAllDocuments(text)) {
+      visit(yamlDocument, (_key, node, path) => {
+        if (!isAlias(node)) {
+          return
+        }
+        const target = node.resolve(yamlDocument)
+        if (!target || !path.includes(target) || !node.range) {
+          return
+        }
+        const [start, end] = node.range
+        diagnostics.push({
+          code: 'recursive-alias',
+          message: `Recursive YAML alias ${String(node)} is not supported.`,
+          range: {
+            start: document.positionAt(start),
+            end: document.positionAt(end)
+          },
+          severity: 1,
+          source: 'YAML'
+        })
+      })
+    }
+  } catch {
+    // Let yaml-language-server report ordinary parse failures.
+  }
+  return diagnostics
+}
